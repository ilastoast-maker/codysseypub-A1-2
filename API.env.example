### Example environment variables for local development
# Copy this file to `API.env` and fill with your real keys.
# Do NOT commit `API.env` (it's already in .gitignore).

# Gemini LLM API key (required for LLM calls)
# Note: variable name required by codebase is `GEMENI_API_KEY` (as requested).
GEMENI_API_KEY=your_gemeni_api_key_here

# Kakao REST API key (used by place_client)
# Variable name: `KAKAO_REST_API_KEY`
KAKAO_REST_API_KEY=your_kakao_rest_api_key_here

# Other optional settings
#LANG=ko
